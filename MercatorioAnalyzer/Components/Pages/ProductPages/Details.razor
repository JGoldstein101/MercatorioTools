@page "/products/details"
@using MercatorioAnalyzer.Components.Components
@using Microsoft.AspNetCore.Components.QuickGrid
@using MercatorioAnalyzer.Data.Client
@using MercatorioAnalyzer.Data.Entity
@using Microsoft.EntityFrameworkCore
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<MercatorioAnalyzer.Data.Client.MercatorioSqliteDBContext> DbFactory
@inject NavigationManager NavigationManager
@inject Storehouse storehouse

<PageTitle>Product</PageTitle>

<h1>Product details</h1>

<div>
    <h2>@Name</h2>
    <hr />
    @if (product is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Classes</dt>
            <dd class="col-sm-10">@product.Classes[0]</dd>
        </dl>
        <RecipeGrid Recipes="ProductRecipes" />
        <div>
            <a href="@($"/products")">Back to List</a>
        </div>
    }
</div>

@code {
    private Product? product;
    private List<Recipe> productRecipes = new List<Recipe>();
    [SupplyParameterFromQuery]
    private string Name { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        product = await context.Product.FirstOrDefaultAsync(m => m.Name == Name);

        if (product is null)
        {
            NavigationManager.NotFound();
        }
        productRecipes = await GetProductRecipesAsync(context, product.Name);
    }

    private async Task<List<Recipe>> GetProductRecipesAsync(MercatorioSqliteDBContext context, string productName)
    {
        var recipes = await context.Recipe.AsNoTracking().ToListAsync();
        return recipes.Where(recipe => recipe.Outputs.Any(output => output.Product == productName)).ToList();
    }
    private IQueryable<Recipe> ProductRecipes => productRecipes.AsQueryable();
}

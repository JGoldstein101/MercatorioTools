@inject PlayerContainer playerContainer
@page "/"
@using Newtonsoft.Json

<PageTitle>Home</PageTitle>

<h1>Mercatorio tools</h1>
Something something mercatorio line go up
<div>
    <input type="text" @bind="apiKey" placeholder="Enter API key"/>
</div>
<div>
    <input type="text" @bind="userEmail" placeholder="Enter email"/>
</div>
<div>
    <button @onclick="saveInfo">Save</button>
</div>
@if(dataSaved)
{
    <div>
        <p role="status">Saved!</p>
    </div>
}
@code {
    private string apiKey = "";
    private string userEmail = "";
    private bool dataSaved = false;

    private async Task saveInfo()
    {
        dataSaved = false;
        playerContainer.apiKey = apiKey;
        playerContainer.apiEmail = userEmail;

        using (var client = new HttpClient())
        {
            var request = new HttpRequestMessage
            {
                Method = HttpMethod.Get,
                RequestUri = new Uri("https://play.mercatorio.io/api/player"),
                Headers =
                {
                    {"X-Merc-User", userEmail},
                    {"Authorization", "Bearer " + apiKey},
                },
            };
            using (var response = await client.SendAsync(request))
            {
                response.EnsureSuccessStatusCode();
                var body = await response.Content.ReadAsStringAsync();
                PlayerData playerData = JsonConvert.DeserializeObject<PlayerData>(body)
                    ?? throw new JsonException("The player response was empty.");
                playerContainer.playerData = playerData;
            }   
        }
        dataSaved = true;

    }
}
@inject PlayerContainer playerContainer
@inject Storehouse storehouse
@inject MercatorioApiClient apiClient
@page "/"
@using MercatorioAnalyzer.Data.Client
@using Newtonsoft.Json

<PageTitle>Home</PageTitle>

<h1>Mercatorio tools</h1>
Something something mercatorio line go up
<div>
    <input type="text" @bind="playerContainer.apiKey" placeholder="Enter API key"/>
</div>
<div>
    <input type="text" @bind="playerContainer.apiEmail" placeholder="Enter email"/>
</div>
<div>
    <button @onclick="saveInfo">Save</button>
</div>
<div>
    <p role="status">@dataStatus</p>
</div>
@code {
    private string dataStatus = "";

    private async Task saveInfo()
    {
        dataStatus = "Fetching";
        try
        {
            playerContainer.playerData = await apiClient.GetPlayerDataAsync();
            storehouse.building = await apiClient.GetStorehouse();
            dataStatus = "Data fetched";
        } catch (Exception ex)
        {
            dataStatus = ex.Message;
        }


    }
}
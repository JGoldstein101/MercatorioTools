@page "/recipes"
@using MercatorioAnalyzer.Data.Client
@using MercatorioAnalyzer.Data.Entity
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using Microsoft.EntityFrameworkCore.Query.Internal
@using Newtonsoft.Json
@implements IAsyncDisposable
@inject IDbContextFactory<MercatorioAnalyzer.Data.Client.MercatorioSqliteDBContext> DbFactory
@inject MercatorioApiClient mercatorioApiClient
@inject NavigationManager NavigationManager
@inject Storehouse storehouse
<PageTitle>Recipes</PageTitle>

<h1>Recipes</h1>

<div>
    <button @onclick="SyncRecipes">Sync now</button>
</div>
<div>
    <input typer="search" @bind="recipeFilter" @bind:event="oninput">
</div>
<div>
    <label>
        <input type="checkbox" @bind="showEstimatedCost" />
        Show estimated production cost
    </label>
</div>
<div class="recipe-grid">
    <QuickGrid @ref="recipeGrid" Class="table" Items="FilteredRecipes" Pagination="pagination" >
        <PropertyColumn Property="recipe => recipe.Name" />
        <PropertyColumn Property="recipe => recipe.Tier" Sortable="true"/>
        <PropertyColumn Property="recipe => recipe.Site" />
        <PropertyColumn Property="recipe => recipe.Class" />
        <PropertyColumn Property="recipe => recipe.Points" Sortable="true"/>
        <TemplateColumn Title="Inputs" Context="recipe">
            @FormatRecipeItems(recipe.Inputs)
        </TemplateColumn>
        <TemplateColumn Title="Outputs" Context="recipe">
            @FormatRecipeItems(recipe.Outputs)
        </TemplateColumn>
        <TemplateColumn Title="Estimated cost" Context="recipe" Sortable="true">
            @EstimateProductionCost(recipe.Inputs, recipe.Outputs)
        </TemplateColumn>
        <TemplateColumn Context="recipe">
            <a href="@($"recipes/details?name={recipe.Name}")">Details</a>
        </TemplateColumn>
    </QuickGrid>
</div>
<Paginator State="pagination" />
@code {
    private bool showEstimatedCost = false;
    private MercatorioSqliteDBContext context = default!;
    private QuickGrid<Recipe>? recipeGrid;
    private string recipeFilter = string.Empty;
    private PaginationState pagination = new PaginationState{ItemsPerPage = 20};

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();

    /// <summary>
    /// Fetches latesst recipe list from mercatorio and refreshes the db
    /// </summary>
    /// <returns></returns>
    public async Task SyncRecipes()
    {
        var recipes = await mercatorioApiClient.GetRecipesAsync();
        if(recipes.Count == 0)
        {
            throw new InvalidDataException("No data returned from recipes endpoint");
        }
        await using var db = await DbFactory.CreateDbContextAsync();
        await using var transaction = await db.Database.BeginTransactionAsync();
        await db.Recipe.ExecuteDeleteAsync();
        db.Recipe.AddRange(recipes);
        await db.SaveChangesAsync();
        await transaction.CommitAsync();
        context.ChangeTracker.Clear();
        if(recipeGrid is not null)
        {
            await recipeGrid.RefreshDataAsync();
        }
    }

    private string FormatRecipeItems(List<RecipeItem> recipeItems)
    {
        return string.Join(", ", recipeItems.Select(item => String.Format("{0} {1}",item.Amount, item.Product)));
    }

    private IQueryable<Recipe> FilteredRecipes => context.Recipe.Where(recipe => recipe.Name!.Contains(recipeFilter));

    /// <summary>
    /// calculate the estimate cost of producing 1 output of this recipe using player's current inventory costs
    /// </summary>
    /// <param name="recipeInputItems">the list of inputs to the recipe</param>
    /// <pam name="recipeOutputItems"> the list of outputs of the recipe</param>
    /// <returns>the estimated per unit production cost of the recipe given the user's current inventory </returns>
    private decimal EstimateProductionCost(List<RecipeItem> recipeInputItems, List<RecipeItem> recipeOutputItems)
    {
        decimal estimatedProductionCost = 0.0m;
        if(showEstimatedCost == false)
        {
            return estimatedProductionCost;
        }
        BuildingAssetData inventoryItem;
        BuildingPreviousFlow previousFlow;
        foreach(var recipeItem in recipeInputItems)
        {
            if(storehouse.building.Storage.Inventory.Account.Assets.TryGetValue(recipeItem.Product, out inventoryItem))
            {
                estimatedProductionCost += inventoryItem.UnitCost * recipeItem.Amount;
            }
            else
            {
                estimatedProductionCost = 0;
                break;
            }
            if(storehouse.building.Storage.Inventory.PreviousFlows.TryGetValue(recipeItem.Product, out previousFlow))
            {
                if(previousFlow.Production > 0)
                {
                    estimatedProductionCost += (previousFlow.ProductionCost / previousFlow.Production) * recipeItem.Amount;
                }
            }
        }
        if(recipeOutputItems.Count == 1)
        {
            estimatedProductionCost /= recipeOutputItems.First().Amount;
        }
        else
        {
            estimatedProductionCost = 0;
        }
        return Math.Round(estimatedProductionCost,2);

    }
}

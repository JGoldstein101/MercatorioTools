@page "/recipes"
@using MercatorioAnalyzer.Components.Components
@using MercatorioAnalyzer.Data.Client
@using MercatorioAnalyzer.Data.Entity
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using Microsoft.EntityFrameworkCore.Query.Internal
@using Newtonsoft.Json
@implements IAsyncDisposable
@inject IDbContextFactory<MercatorioAnalyzer.Data.Client.MercatorioSqliteDBContext> DbFactory
@inject MercatorioApiClient mercatorioApiClient
@inject NavigationManager NavigationManager
@inject Storehouse storehouse
<PageTitle>Recipes</PageTitle>

<h1>Recipes</h1>

<div>
    <button @onclick="SyncRecipes">Sync now</button>
</div>
<div>
    <input typer="search" @bind="recipeFilter" @bind:event="oninput">
</div>
<div class="recipe-grid">
    <RecipeGrid Recipes="FilteredRecipes" />
</div>
@code {
    private MercatorioSqliteDBContext context = default!;
    private string recipeFilter = string.Empty;
    protected override async Task OnInitializedAsync()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();

    /// <summary>
    /// Fetches latesst recipe list from mercatorio and refreshes the db
    /// </summary>
    /// <returns></returns>
    public async Task SyncRecipes()
    {
        var recipes = await mercatorioApiClient.GetRecipesAsync();
        if(recipes.Count == 0)
        {
            throw new InvalidDataException("No data returned from recipes endpoint");
        }
        await using var db = await DbFactory.CreateDbContextAsync();
        await using var transaction = await db.Database.BeginTransactionAsync();
        await db.Recipe.ExecuteDeleteAsync();
        db.Recipe.AddRange(recipes);
        await db.SaveChangesAsync();
        await transaction.CommitAsync();
        context.ChangeTracker.Clear();
        /*if(recipeGrid is not null)
        {
            await recipeGrid.RefreshDataAsync();
        }*/
    }

    private IQueryable<Recipe> FilteredRecipes => context.Recipe.Where(recipe => recipe.Name!.Contains(recipeFilter));
}
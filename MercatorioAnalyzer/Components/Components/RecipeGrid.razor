@using Microsoft.AspNetCore.Components.QuickGrid
@inject Storehouse storehouse

<QuickGrid TGridItem="Recipe" Items = "Recipes" Pagination="pagination">
    <PropertyColumn Property="recipe => recipe.Name" />
    <PropertyColumn Property="recipe => recipe.Tier" Sortable="true"/>
    <PropertyColumn Property="recipe => recipe.Site" />
    <PropertyColumn Property="recipe => recipe.Class" />
    <PropertyColumn Property="recipe => recipe.Points" Sortable="true"/>
    <TemplateColumn Title="Inputs" Context="recipe">
        @FormatRecipeItems(recipe.Inputs)
    </TemplateColumn>
    <TemplateColumn Title="Outputs" Context="recipe">
        @FormatRecipeItems(recipe.Outputs)
    </TemplateColumn>
    <TemplateColumn Title="Estimated cost" Context="recipe" SortBy="@estimatedCostSort">
        @EstimateProductionCost(recipe.Inputs, recipe.Outputs)
    </TemplateColumn>
    <TemplateColumn Context="recipe">
        <a href="@($"recipes/details?name={recipe.Name}")">Details</a>
    </TemplateColumn>
</QuickGrid>
<Paginator State="pagination" />
@code {
    [Parameter, EditorRequired]
    public IQueryable<Recipe> Recipes { get; set; } = default;
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
    private GridSort<Recipe> estimatedCostSort;
    private PaginationState pagination = new PaginationState{ItemsPerPage = 20};
    protected override async Task OnInitializedAsync()
    {
        estimatedCostSort = GridSort<Recipe>.ByAscending(recipe => EstimateProductionCost(recipe.Inputs, recipe.Outputs));
    }
    private string FormatRecipeItems(List<RecipeItem> recipeItems)
    {
        return string.Join(", ", recipeItems.Select(item => String.Format("{0} {1}",item.Amount, item.Product)));
    }

    /// <summary>
    /// calculate the estimate cost of producing 1 output of this recipe using player's current inventory costs
    /// </summary>
    /// <param name="recipeInputItems">the list of inputs to the recipe</param>
    /// <pam name="recipeOutputItems"> the list of outputs of the recipe</param>
    /// <returns>the estimated per unit production cost of the recipe given the user's current inventory </returns>
    private decimal EstimateProductionCost(List<RecipeItem> recipeInputItems, List<RecipeItem> recipeOutputItems)
    {
        decimal estimatedProductionCost = 0.0m;
        BuildingAssetData inventoryItem;
        BuildingPreviousFlow previousFlow;
        foreach(var recipeItem in recipeInputItems)
        {
            if(storehouse.building.Storage.Inventory.Account.Assets.TryGetValue(recipeItem.Product, out inventoryItem))
            {
                if(inventoryItem.Balance > 0)
                {
                    estimatedProductionCost += inventoryItem.UnitCost * recipeItem.Amount;
                }
                else
                {
                    estimatedProductionCost = 0;
                    break;
                }
            }
            else
            {
                estimatedProductionCost = 0;
                break;
            }
        }
        if(recipeOutputItems.Count == 1)
        {
            estimatedProductionCost /= recipeOutputItems.First().Amount;
        }
        else
        {
            estimatedProductionCost = 0;
        }
        return Math.Round(estimatedProductionCost,2);

    }
}
